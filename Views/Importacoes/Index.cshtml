@model IReadOnlyList<Hermenos.DTOs.Importacao.LoteImportacaoDTO>
@{
	ViewData["Title"] = "Importações";
	ViewData["Section"] = "Importações";
	int? empresaId = ViewBag.EmpresaId;
	var concluidos = Model.Count(x => x.Situacao == "Concluído");
	var comAlertas = Model.Count(x => x.Situacao.Contains("alertas", StringComparison.OrdinalIgnoreCase));
	var falhas = Model.Count(x => x.Situacao.Contains("Falha", StringComparison.OrdinalIgnoreCase));
}

<div class="import-page">
<div class="page-heading">
	<div>
		<span class="eyebrow">ENTRADA DE DADOS</span>
		<h1>Lotes de importação</h1>
		<p>@(ViewBag.NomeEmpresa ?? "Arquivos de todas as empresas") · acompanhe os resultados do processamento.</p>
	</div>
	<span class="demo-label">CONSULTA DE LOTES</span>
</div>

<section class="summary-strip import-summary" aria-label="Resumo dos lotes">
	<div><span>Lotes recebidos</span><strong>@Model.Count</strong></div>
	<div><span>Concluídos</span><strong class="success-text">@concluidos</strong></div>
	<div><span>Com alertas</span><strong class="warning-text">@comAlertas</strong></div>
	<div><span>Com falha</span><strong class="danger-text">@falhas</strong></div>
</section>

<div class="info-banner mb-3" role="note">
	<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 10h2v7h-2v-7Zm0-3h2v2h-2V7Zm1-5a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z" /></svg>
	<div><strong>Importação em modo de consulta</strong><span>O backend atual disponibiliza somente a listagem. O envio de novos arquivos depende de uma Action específica.</span></div>
</div>

<section class="surface">
	<div class="surface-heading">
		<div><h2>Histórico de lotes</h2><p>Arquivos recebidos, quantidades processadas e situação atual.</p></div>
		@if (empresaId.HasValue)
		{
			<a class="btn btn-outline-secondary btn-sm" asp-action="Importacoes">Ver todas as empresas</a>
		}
	</div>
	<div class="table-responsive">
		<table class="table data-table align-middle mb-0">
			<caption class="visually-hidden">Lotes de importação recebidos</caption>
			<thead><tr><th scope="col">Arquivo</th><th scope="col">Origem</th><th scope="col">Recebido em</th><th scope="col">Identificados</th><th scope="col">Válidos</th><th scope="col">Alertas</th><th scope="col">Situação</th><th scope="col"><span class="visually-hidden">Detalhes</span></th></tr></thead>
			<tbody>
				@foreach (var lote in Model)
				{
					var collapseId = $"lote-{lote.Id}";
					var statusClass = lote.Situacao == "Concluído" ? "status-success" : lote.Situacao.Contains("Falha") ? "status-danger" : "status-warning";
					<tr>
						<td><span class="file-cell"><span class="file-type">@lote.Formato</span><span><strong>@lote.Arquivo</strong><small>Lote #@lote.Id</small></span></span></td>
						<td>@lote.Origem</td>
						<td>@lote.Recebido.ToString("dd/MM/yyyy HH:mm")<small>por @lote.Usuario</small></td>
						<td><span class="number-cell">@lote.Encontrados</span></td>
						<td><span class="number-cell success-text">@lote.Validos</span></td>
						<td><span class="number-cell @(lote.Rejeitados + lote.Duplicados > 0 ? "warning-text" : "")">@(lote.Rejeitados + lote.Duplicados)</span></td>
						<td><span class="status-badge @statusClass"><span aria-hidden="true"></span>@lote.Situacao</span></td>
						<td class="text-end"><button class="btn btn-sm btn-row" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">Detalhes</button></td>
					</tr>
					<tr class="collapse comparison-detail" id="@collapseId">
						<td colspan="8">
							<div class="lot-detail">
								<div><span>Registros encontrados</span><strong>@lote.Encontrados</strong></div>
								<div><span>Registros válidos</span><strong class="success-text">@lote.Validos</strong></div>
								<div><span>Rejeitados</span><strong class="@(lote.Rejeitados > 0 ? "danger-text" : "")">@lote.Rejeitados</strong></div>
								<div><span>Duplicados</span><strong class="@(lote.Duplicados > 0 ? "warning-text" : "")">@lote.Duplicados</strong></div>
								<div class="lot-audit"><span>Recebido por</span><strong>@lote.Usuario</strong><small>Informação fornecida pelo backend</small></div>
								<div class="lot-audit"><span>Data de recebimento</span><strong>@lote.Recebido.ToString("dd/MM/yyyy HH:mm")</strong><small>Informação somente leitura</small></div>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	@if (Model.Count == 0)
	{
		<div class="empty-state"><span class="empty-icon" aria-hidden="true">⇧</span><h3>Nenhum lote recebido</h3><p>Ainda não existem importações para o contexto selecionado.</p><a class="btn btn-outline-primary btn-sm" asp-action="Importacoes">Ver todos os lotes</a></div>
	}
</section>
</div>
