@model IReadOnlyList<DivergenciaLinhaViewModel>
@{
	ViewData["Title"] = "Divergências";
	ViewData["Section"] = "Divergências";
	var situacao = (string?)ViewBag.Situacao;
	var categoria = (string?)ViewBag.Categoria;
	var busca = (string?)ViewBag.Busca;
	int? empresaId = ViewBag.EmpresaId;
	var contagemCategorias = Model.GroupBy(x => x.Item.Categoria).Select(g => new { Nome = g.Key, Total = g.Count() }).OrderByDescending(x => x.Total).ToList();
}

<div class="page-heading">
	<div>
		<span class="eyebrow">ANÁLISE DE INCONSISTÊNCIAS</span>
		<h1>Divergências</h1>
		<p>@(ViewBag.NomeEmpresa ?? "Ocorrências de todas as empresas") · investigue as diferenças encontradas entre as fontes.</p>
	</div>
	<span class="result-count"><strong>@Model.Count</strong> @(Model.Count == 1 ? "ocorrência encontrada" : "ocorrências encontradas")</span>
</div>

<section class="surface">
	<div class="mini-analysis" aria-label="Divergências por categoria">
		<h2>Divergências por categoria</h2>
		<div class="mini-analysis-list divergence-category-list">
			@foreach (var categoriaAtual in contagemCategorias)
			{
				<div class="mini-analysis-item"><div><span>@categoriaAtual.Nome</span><strong>@categoriaAtual.Total</strong></div></div>
			}
			@if (contagemCategorias.Count == 0) { <p class="mb-0">Sem dados para os filtros informados.</p> }
		</div>
	</div>
	<form method="get" class="filter-panel filter-panel-wide" data-loading-form>
		@if (empresaId.HasValue)
		{
			<input type="hidden" name="empresaId" value="@empresaId" />
		}
		<div class="filter-field filter-search">
			<label for="divergencia-busca">Empresa, documento ou campo</label>
			<input class="form-control" id="divergencia-busca" name="busca" value="@busca" placeholder="Digite nome, número, responsável ou valor" />
		</div>
		<div class="filter-field">
			<label for="divergencia-situacao">Situação da análise</label>
			<select class="form-select" id="divergencia-situacao" name="situacao">
				<option value="">Todas as situações</option>
				@foreach (var opcao in new[] { "Pendente", "Em análise", "Tratada", "Encerrada" })
				{
					<option value="@opcao" selected="@(situacao == opcao)">@opcao</option>
				}
			</select>
		</div>
		<div class="filter-field">
			<label for="divergencia-categoria">Categoria</label>
			<select class="form-select" id="divergencia-categoria" name="categoria">
				<option value="">Todas as categorias</option>
				@foreach (var opcao in new[] { "Documento ausente em uma das fontes", "Diferença de valor", "Diferença de quantidade", "Possível duplicidade", "Situação de cancelamento para revisão" })
				{
					<option value="@opcao" selected="@(categoria == opcao)">@opcao</option>
				}
			</select>
		</div>
		<button class="btn btn-primary" type="submit" data-loading-label="Buscando...">Buscar</button>
		@if (!string.IsNullOrWhiteSpace(busca) || !string.IsNullOrWhiteSpace(situacao) || !string.IsNullOrWhiteSpace(categoria))
		{
			<a class="btn btn-outline-secondary" asp-action="Divergencias" asp-route-empresaId="@empresaId">Limpar</a>
		}
	</form>

	<div class="table-responsive">
		<table class="table data-table table-divergencias align-middle mb-0">
			<caption class="visually-hidden">Divergências encontradas</caption>
			<thead><tr><th scope="col">Empresa / documento</th><th scope="col">Categoria / campo</th><th scope="col">XML</th><th scope="col">ERP</th><th scope="col">Identificada em</th><th scope="col">Responsável</th><th scope="col">Situação</th><th scope="col"><span class="visually-hidden">Detalhes</span></th></tr></thead>
			<tbody>
				@foreach (var linha in Model)
				{
					var divergencia = linha.Item;
					var collapseId = $"divergencia-{divergencia.Id}";
					var statusClass = divergencia.Situacao == "Pendente" ? "status-warning" : divergencia.Situacao == "Em análise" ? "status-info" : "status-success";
					<tr>
						<td><a class="primary-cell" asp-controller="Empresas" asp-action="Detalhes" asp-route-id="@divergencia.IdEmpresa">@linha.Empresa</a><small>Documento @linha.Documento · ID #@divergencia.Id</small></td>
						<td>@divergencia.Categoria<small>@divergencia.Campo</small></td>
						<td><span class="value-chip">@divergencia.ValorXml</span></td>
						<td><span class="value-chip value-chip-different">@divergencia.ValorErp</span></td>
						<td>@divergencia.Identificada.ToString("dd/MM/yyyy")</td>
						<td>@divergencia.Responsavel</td>
						<td><span class="status-badge @statusClass"><span aria-hidden="true"></span>@divergencia.Situacao</span></td>
						<td class="text-end"><button class="btn btn-sm btn-row" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">Analisar</button></td>
					</tr>
					<tr class="collapse comparison-detail" id="@collapseId">
						<td colspan="8">
							<div class="divergence-detail">
								<div class="detail-title"><span class="attention-icon amber" aria-hidden="true">!</span><div><h3>@divergencia.Categoria</h3><p>Campo divergente: <strong>@divergencia.Campo</strong></p></div></div>
								<div class="value-comparison"><div><span>VALOR NO XML</span><strong>@divergencia.ValorXml</strong></div><div><span>VALOR NO ERP</span><strong>@divergencia.ValorErp</strong></div></div>
								<dl class="detail-metadata"><div><dt>Data de identificação</dt><dd>@divergencia.Identificada.ToString("dd/MM/yyyy")</dd></div><div><dt>Responsável pela análise</dt><dd>@divergencia.Responsavel</dd></div><div><dt>Situação atual</dt><dd>@divergencia.Situacao</dd></div></dl>
								<p class="backend-note">Alterações de situação e responsável dependem de uma Action de atualização, ainda não disponível no backend.</p>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	@if (Model.Count == 0)
	{
		<div class="empty-state"><span class="empty-icon" aria-hidden="true">✓</span><h3>Nenhuma divergência encontrada</h3><p>Não há ocorrências que correspondam aos filtros selecionados.</p><a class="btn btn-outline-primary btn-sm" asp-action="Divergencias" asp-route-empresaId="@empresaId">Limpar filtros</a></div>
	}
</section>
