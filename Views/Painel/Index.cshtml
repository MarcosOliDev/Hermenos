@model Hermenos.ViewModels.Painel.PainelGeralViewModel
@{
	ViewData["Title"] = "Painel geral";
	ViewData["Section"] = "Painel geral";
	var competenciaPartes = Model.Competencia.Split('-');
	var competencia = competenciaPartes.Length == 2 ? $"{competenciaPartes[1]}/{competenciaPartes[0]}" : Model.Competencia;
	ViewData["Competencia"] = competencia;
	var totalSituacaoReal = Model.SituacoesDocumentos.Sum(x => x.Quantidade);
	var totalSituacao = Math.Max(1, totalSituacaoReal);
	var conciliadosPct = Model.SituacoesDocumentos.First(x => x.Nome == "Conciliados").Quantidade * 100 / totalSituacao;
	var divergentesPct = Model.SituacoesDocumentos.First(x => x.Nome == "Divergentes").Quantidade * 100 / totalSituacao;
	var pendentesPct = Model.SituacoesDocumentos.First(x => x.Nome == "Pendentes").Quantidade * 100 / totalSituacao;
	var ausentesPct = Math.Max(0, 100 - conciliadosPct - divergentesPct - pendentesPct);
	var percentualSituacoes = totalSituacaoReal == 0 ? "background:#64748b" : $"background: conic-gradient(#16a34a 0 {conciliadosPct}%, #f59e0b {conciliadosPct}% {conciliadosPct + divergentesPct}%, #3b82f6 {conciliadosPct + divergentesPct}% {conciliadosPct + divergentesPct + pendentesPct}%, #ef4444 {conciliadosPct + divergentesPct + pendentesPct}% 100%)";
	var maxEvolucao = Math.Max(1, Model.EvolucaoConciliacao.SelectMany(x => new[] { x.Conciliados, x.Divergentes }).DefaultIfEmpty(1).Max());
	var pontosConciliados = string.Join(" ", Model.EvolucaoConciliacao.Select((x, i) => $"{(Model.EvolucaoConciliacao.Count == 1 ? 200 : 24 + i * 352 / (Model.EvolucaoConciliacao.Count - 1))},{112 - x.Conciliados * 90 / maxEvolucao}"));
	var pontosDivergentes = string.Join(" ", Model.EvolucaoConciliacao.Select((x, i) => $"{(Model.EvolucaoConciliacao.Count == 1 ? 200 : 24 + i * 352 / (Model.EvolucaoConciliacao.Count - 1))},{112 - x.Divergentes * 90 / maxEvolucao}"));
}

<div class="page-heading">
	<div>
		<span class="eyebrow">VISÃO CONSOLIDADA</span>
		<h1>Painel geral</h1>
		<p>Acompanhe a saúde fiscal da carteira e priorize o que precisa de atenção.</p>
	</div>
	<a class="btn btn-primary" asp-controller="Empresas" asp-action="Index">
		Ver todas as empresas
		<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 4 6 6-6 6-1.4-1.4 4.6-4.6-4.6-4.6L8 4Z" /></svg>
	</a>
</div>

<div class="context-bar">
	<div class="context-copy">
		<span class="live-indicator" aria-hidden="true"></span>
		<span>Dados consolidados da competência <strong>@competencia</strong></span>
	</div>
	<span class="updated-at">Atualizado em @Model.AtualizadoEm.ToString("dd/MM/yyyy 'às' HH:mm")</span>
</div>

<section class="metric-grid" aria-label="Indicadores principais">
	<a class="metric-card" asp-controller="Empresas" asp-action="Index">
		<span class="metric-icon blue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l5 5v15H6V2Zm2 2v16h10V8h-4V4H8Zm2 8h6v2h-6v-2Zm0 4h6v2h-6v-2Z" /></svg></span>
		<span class="metric-label">Documentos identificados</span>
		<strong data-contador="@Model.DocumentosIdentificados">@Model.DocumentosIdentificados</strong>
		<small>Documentos encontrados na competência</small>
	</a>
	<a class="metric-card" asp-controller="Conciliacao" asp-action="Index">
		<span class="metric-icon green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.4 18.4-4.8-4.8L6 12.2l3.4 3.4L18 7l1.4 1.4-10 10Z" /></svg></span>
		<span class="metric-label">Conciliados</span>
		<strong data-contador="@Model.DocumentosConciliados">@Model.DocumentosConciliados</strong>
		<small>Sem divergência entre as fontes</small>
	</a>
	<a class="metric-card metric-card-progress" asp-controller="Conciliacao" asp-action="Divergencias" asp-route-situacao="Pendente">
		<span class="metric-content">
			<span class="metric-label">Pendentes</span>
			<strong data-contador="@Model.DocumentosPendentes">@Model.DocumentosPendentes</strong>
			<small>Em análise ou aguardando ação</small>
		</span>
		<svg class="progress-ring" viewBox="0 0 58 58" data-progresso="@Model.PercentualPendentes" role="img" aria-label="@Model.PercentualPendentes% dos documentos pendentes">
			<circle class="progress-ring-track" cx="29" cy="29" r="23" />
			<circle class="progress-ring-value" cx="29" cy="29" r="23" />
			<text x="29" y="32" text-anchor="middle">@Model.PercentualPendentes%</text>
		</svg>
	</a>
	<a class="metric-card" asp-controller="Conciliacao" asp-action="Divergencias">
		<span class="metric-icon red"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 7h2v6h-2V7Zm0 8h2v2h-2v-2Zm1-13 10 19H2L12 2Zm0 4.2L5.3 19h13.4L12 6.2Z" /></svg></span>
		<span class="metric-label">Divergências pendentes</span>
		<strong data-contador="@Model.DocumentosDivergentes">@Model.DocumentosDivergentes</strong>
		<small>Divergentes ou ausentes no ERP</small>
	</a>
</section>

<div class="dashboard-grid">
	<section class="surface mb-0">
		<div class="surface-heading">
			<div><h2>Análise da carteira</h2><p>Indicadores relevantes para priorizar o trabalho fiscal.</p></div>
			<a class="link-action" asp-controller="Conciliacao" asp-action="Divergencias">Ver divergências <span aria-hidden="true">→</span></a>
		</div>
		<div class="dashboard-chart-tabs nav nav-pills" role="tablist" aria-label="Gráficos principais">
	<button class="nav-link active" id="tab-conciliacao" data-bs-toggle="pill" data-bs-target="#grafico-conciliacao" type="button" role="tab" aria-controls="grafico-conciliacao" aria-selected="true">Situação</button>
	<button class="nav-link" id="tab-evolucao" data-bs-toggle="pill" data-bs-target="#grafico-evolucao" type="button" role="tab" aria-controls="grafico-evolucao" aria-selected="false">Evolução</button>
	<button class="nav-link" id="tab-empresas-abertas" data-bs-toggle="pill" data-bs-target="#grafico-empresas-abertas" type="button" role="tab" aria-controls="grafico-empresas-abertas" aria-selected="false">Empresas com divergências</button>
	<button class="nav-link" id="tab-divergencias" data-bs-toggle="pill" data-bs-target="#grafico-divergencias" type="button" role="tab" aria-controls="grafico-divergencias" aria-selected="false">Por categoria</button>
</div>
<div class="tab-content dashboard-chart-content">
	<div class="tab-pane fade show active" id="grafico-conciliacao" role="tabpanel" aria-labelledby="tab-conciliacao" tabindex="0">
		<div class="reconciliation-chart">
			<div class="reconciliation-donut" role="img" aria-label="Distribuição dos documentos: @string.Join(", ", Model.SituacoesDocumentos.Select(x => $"{x.Quantidade} {x.Nome}"))" style="@percentualSituacoes">
				<div><strong>@Model.SituacoesDocumentos.Sum(x => x.Quantidade)</strong><span>documentos</span></div>
			</div>
			<div class="reconciliation-legend">
				@foreach (var situacaoDocumento in Model.SituacoesDocumentos)
				{
					<div><span class="legend-swatch" style="background:@situacaoDocumento.Cor"></span><span>@situacaoDocumento.Nome</span><strong>@situacaoDocumento.Quantidade</strong></div>
				}
				<small>Distribuição da competência selecionada</small>
			</div>
		</div>
	</div>
	<div class="tab-pane fade" id="grafico-evolucao" role="tabpanel" aria-labelledby="tab-evolucao" tabindex="0">
		<div class="evolution-chart">
			<svg viewBox="0 0 400 132" role="img" aria-label="Evolução semanal de documentos conciliados e divergentes">
				<path class="evolution-gridline" d="M20 22H380 M20 67H380 M20 112H380" />
				<polyline class="evolution-line evolution-line-ok" points="@pontosConciliados" />
				<polyline class="evolution-line evolution-line-alert" points="@pontosDivergentes" />
			</svg>
			<div class="evolution-labels">@foreach (var periodo in Model.EvolucaoConciliacao) { <span>@periodo.Periodo</span> }</div>
			<div class="evolution-legend"><span><i class="legend-ok"></i>Conciliados</span><span><i class="legend-attention"></i>Divergentes</span><small>Documentos agrupados pela data de emissão</small></div>
		</div>
	</div>
	<div class="tab-pane fade" id="grafico-empresas-abertas" role="tabpanel" aria-labelledby="tab-empresas-abertas" tabindex="0">
		<div class="chart-list">
			@foreach (var empresa in Model.EmpresasComDivergencias)
			{
				var percentual = empresa.Quantidade * 100 / Math.Max(1, Model.EmpresasComDivergencias.Max(x => x.Quantidade));
				<div class="chart-item"><div><span>@empresa.Nome</span><strong>@empresa.Quantidade</strong></div><div class="bar-track"><div class="bar c2" data-barra="@percentual"></div></div></div>
			}
			@if (Model.EmpresasComDivergencias.Count == 0) { <div class="chart-empty">Não há divergências em aberto.</div> }
		</div>
	</div>
	<div class="tab-pane fade" id="grafico-divergencias" role="tabpanel" aria-labelledby="tab-divergencias" tabindex="0">
		<div class="chart-list">
			@foreach (var categoria in Model.Categorias)
			{
				var percentual = Math.Max(8, categoria.Quantidade * 100 / Model.MaiorCategoria);
				<div class="chart-item"><div><span>@categoria.Nome</span><strong>@categoria.Quantidade</strong></div><div class="bar-track" role="img" aria-label="@categoria.Nome: @categoria.Quantidade ocorrência(s)"><div class="bar @categoria.Classe" data-barra="@percentual"></div></div></div>
			}
			@if (Model.Categorias.All(c => c.Quantidade == 0)) { <div class="chart-empty">Não há divergências nos filtros selecionados.</div> }
		</div>
	</div>
	</div>
</section>
</div>


<div class="dashboard-data-grid">
	<section class="surface" data-fullscreen-box>
	<div class="surface-heading">
		<div>
			<h2>Divergências recentes</h2>
			<p>Ocorrências em aberto que precisam de acompanhamento.</p>
		</div>
		<a class="link-action" asp-controller="Conciliacao" asp-action="Divergencias">Ver todas as divergências <span aria-hidden="true">→</span></a>
	</div>
	<div class="table-responsive">
		<table class="table data-table dashboard-company-table table-dashboard-recent align-middle mb-0">
			<caption class="visually-hidden">Divergências recentes da competência @competencia</caption>
			<thead><tr><th scope="col">Empresa</th><th scope="col">Documento</th><th scope="col">Divergência</th><th scope="col">Identificada em</th><th scope="col">Situação</th><th scope="col"><span class="visually-hidden">Ação</span></th></tr></thead>
			<tbody>
				@foreach (var divergencia in Model.PendenciasRecentes.Take(8))
				{
					<tr>
						<td><a class="primary-cell" asp-controller="Empresas" asp-action="Detalhes" asp-route-id="@divergencia.EmpresaId">@divergencia.Empresa</a></td>
						<td>@divergencia.Documento</td>
						<td>@divergencia.Categoria</td>
						<td>@divergencia.Identificada.ToString("dd/MM/yyyy")</td>
						<td><span class="status-badge @(divergencia.Situacao == "Em análise" ? "status-info" : "status-warning")"><span aria-hidden="true"></span>@divergencia.Situacao</span></td>
						<td class="text-end"><a class="icon-link" asp-controller="Conciliacao" asp-action="Divergencias" asp-route-empresaId="@divergencia.EmpresaId">Analisar <span aria-hidden="true">→</span></a></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	@if (Model.PendenciasRecentes.Count == 0)
	{
		<div class="empty-state">
			<span class="empty-icon" aria-hidden="true">✓</span>
			<h3>Nenhuma divergência recente</h3>
			<p>Não há divergências em aberto nos filtros selecionados.</p>
		</div>
	}
</section>
	<section class="surface" data-fullscreen-box>
		<div class="surface-heading">
			<div><h2>Empresas em destaque</h2><p>Clientes com mais documentos ou pendências na competência.</p></div>
			<a class="link-action" asp-controller="Empresas" asp-action="Index">Ver carteira completa <span aria-hidden="true">→</span></a>
		</div>
		<div class="table-responsive">
			<table class="table data-table dashboard-company-table table-dashboard-company align-middle mb-0">
				<caption class="visually-hidden">Empresas com mais pendências na competência @competencia</caption>
				<thead><tr><th scope="col">Empresa</th><th scope="col">Documentos</th><th scope="col">Pendências</th><th scope="col">Situação</th><th scope="col"><span class="visually-hidden">Ação</span></th></tr></thead>
				<tbody>
				@foreach (var empresa in Model.Empresas.OrderByDescending(e => e.Pendencias).ThenByDescending(e => e.Documentos).Take(6))
				{
					<tr>
						<td><a class="primary-cell" asp-controller="Empresas" asp-action="Detalhes" asp-route-id="@empresa.Id">@empresa.Nome</a></td>
						<td>@empresa.Documentos</td><td>@empresa.Pendencias</td>
						<td><span class="status-badge @(empresa.Situacao == "Em dia" ? "status-success" : "status-warning")"><span aria-hidden="true"></span>@empresa.Situacao</span></td>
						<td><a class="icon-link" asp-controller="Empresas" asp-action="Detalhes" asp-route-id="@empresa.Id">Abrir →</a></td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</section>
</div>

